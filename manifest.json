{
  "manifest_version": 3,
  "name": "界面取证镜（pattern-lens）",
  "version": "0.1.0",
  "description": "只做取证不做打分：列出当前页的可疑模式（待核对），每条附规则名、原文片段、元素定位与严重度，并导出证据包。",
  "minimum_chrome_version": "114",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "界面取证镜：检查本页"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "web_accessible_resources": []
}
